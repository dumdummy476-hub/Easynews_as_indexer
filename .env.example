EASYNEWS_USER=your_easynews_username
EASYNEWS_PASS=your_easynews_password
NEWZNAB_APIKEY=replace-with-a-long-random-api-key
# Optional; defaults to NEWZNAB_APIKEY
INDEXER_SIGNING_SECRET=

EASYNEWS_SEARCH_API=v3
EASYNEWS_V3_MAX_PAGES=3
EASYNEWS_V3_CONCURRENCY=6
EASYNEWS_CONNECT_TIMEOUT=5
EASYNEWS_SEARCH_TIMEOUT=20
EASYNEWS_DOWNLOAD_TIMEOUT=60
EASYNEWS_SEARCH_BUDGET_MS=12000

EASYNEWS_SEARCH_CACHE_TTL=45
EASYNEWS_CACHE_MAX_ENTRIES=1024
EASYNEWS_TITLE_RETRY_TRIGGER=20
EASYNEWS_TMDB_TRIGGER=20
EASYNEWS_POSTED_NZB_TRIGGER=20

EASYNEWS_TMDB_ORIGINAL_TITLE_FALLBACK=false
TMDB_API_KEY=
EASYNEWS_TMDB_CACHE_TTL=86400
EASYNEWS_TMDB_NEGATIVE_CACHE_TTL=900

EASYNEWS_V3_NZB_FALLBACK=false
EASYNEWS_POSTED_NZB_MAX=8
EASYNEWS_POSTED_NZB_CONCURRENCY=4
EASYNEWS_POSTED_NZB_CACHE_TTL=900
EASYNEWS_NNTP_HOST=news.easynews.com
EASYNEWS_NNTP_PORT=563
EASYNEWS_NNTP_TIMEOUT=20

EASYNEWS_SORT_MODE=relevance
NEWZNAB_DEFAULT_LIMIT=100
NEWZNAB_MAX_LIMIT=300
NEWZNAB_DEFAULT_MIN_SIZE_MB=100
ALLOW_LEGACY_UNSIGNED_IDS=false
METRICS_REQUIRE_APIKEY=false

GUNICORN_WORKERS=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=45
