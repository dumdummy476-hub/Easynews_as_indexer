# Copy this file to .env and fill in your credentials

EASYNEWS_USER=your_easynews_username
EASYNEWS_PASS=your_easynews_password

# API key used by Prowlarr/Newznab clients to authenticate to this server
NEWZNAB_APIKEY=testkey

# Optional: override server port (default 8081)
# PORT=8081
# Easynews search API
# v3   = modern API, fixed 100 results/page, parallel pagination
# v2   = legacy API, up to 250 results/request
# auto = prefer V3 and automatically fall back to V2
EASYNEWS_SEARCH_API=v3

# Maximum V3 pages fetched per search.
# Each V3 page contains up to 100 results.
EASYNEWS_V3_MAX_PAGES=3

# Maximum parallel V3 page requests.
# Allowed range: 1-10
EASYNEWS_V3_CONCURRENCY=10
