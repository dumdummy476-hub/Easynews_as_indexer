# Copy this file to .env and fill in your credentials

EASYNEWS_USER=your_easynews_username
EASYNEWS_PASS=your_easynews_password

# API key used by Prowlarr/Newznab clients to authenticate to this server
NEWZNAB_APIKEY=testkey

# Optional: override server port (default 8081)
# PORT=8081
# Easynews search API
# v3   = modern API, fixed 100 results/page, parallel pagination
# v2   = legacy API, up to 250 results/request
# auto = prefer V3 and automatically fall back to V2
EASYNEWS_SEARCH_API=v3

# Maximum V3 pages fetched per search (100 results/page).
# Raising this increases coverage on broad queries at the cost of more
# upstream requests per search. 5 pages = up to 500 results/search.
EASYNEWS_V3_MAX_PAGES=5

# Maximum parallel V3 page requests.
# Allowed range: 1-10
EASYNEWS_V3_CONCURRENCY=10

# Optional: resolve TMDB's canonical/original title for IMDb-only movie
# requests and TVDB-only TV requests (AIOStreams sends these instead of a
# text query once the indexer advertises imdbid/tvdbid support). Also
# enables a retry with the original title when the initial search is weak.
# Requires TMDB_API_KEY.
EASYNEWS_TMDB_ORIGINAL_TITLE_FALLBACK=false
TMDB_API_KEY=

# Optional: when a movie/TV search returns fewer than
# EASYNEWS_V3_NZB_TRIGGER useful results, run one broad Easynews V3 search
# for posted .nzb documents (file_type=ALL) and validate promising
# candidates by fetching them over NNTP. Adds latency to weak searches.
EASYNEWS_V3_NZB_FALLBACK=false
EASYNEWS_V3_NZB_TRIGGER=20
EASYNEWS_V3_NZB_MAX=8
EASYNEWS_V3_NZB_CONCURRENCY=4
